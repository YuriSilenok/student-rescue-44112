[Unit]
Description=Student Rescue 44-112 schedule API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=student-rescue
Group=student-rescue
WorkingDirectory=/opt/student-rescue/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/Moscow
ExecStart=/opt/student-rescue/current/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 44113 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=220M
TasksMax=64
UMask=0027

[Install]
WantedBy=multi-user.target
